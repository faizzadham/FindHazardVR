/* Shared styling for the Convai settings section views.
   Selectors target view-owned convai-settings-* classes so the same sheet
   serves both the Project Settings host and the Convai Editor window. */

.convai-settings-root {
    flex-grow: 1;
}

.convai-settings-header {
    flex-direction: row;
    align-items: center;
    margin: 8px 8px 4px 8px;
}

.convai-settings-header-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
}

.convai-settings-header-title {
    font-size: 15px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.convai-settings-section {
    margin: 6px 8px;
}

.convai-settings-section-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.convai-settings-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(82, 183, 136);
    flex-grow: 1;
    letter-spacing: 1px;
}

.convai-settings-root--light .convai-settings-section-title {
    color: rgb(34, 121, 81);
}

.convai-settings-section-actions {
    flex-direction: row;
}

.convai-settings-card {
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.12);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.convai-settings-root--light .convai-settings-card {
    background-color: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
}

.convai-settings-helpbox {
    margin: 2px 0 6px 0;
}

.convai-settings-field {
    margin: 1px 0;
}

.convai-settings-subgroup {
    margin-top: 4px;
    padding-left: 12px;
}

.convai-settings-subtitle {
    -unity-font-style: bold;
    margin-top: 8px;
}

.convai-settings-hint {
    font-size: 10px;
    opacity: 0.7;
    margin: 0 0 4px 4px;
    white-space: normal;
}

.convai-settings-version {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.convai-settings-row {
    flex-direction: row;
    align-items: center;
}

.convai-settings-apikey-row > .convai-settings-apikey-field {
    flex-grow: 1;
}

.convai-settings-mic-row > DropdownField {
    flex-grow: 1;
}

.convai-settings-action-row {
    margin: 4px 0;
}

.convai-settings-links-row {
    flex-wrap: wrap;
}

.convai-settings-preset-row {
    margin-bottom: 6px;
}

.convai-settings-preset-row > Label {
    margin-right: 6px;
}

.convai-settings-inline-button,
.convai-settings-reset-button,
.convai-settings-chip {
    margin: 1px 2px;
    padding: 2px 8px;
}

.convai-settings-primary-button {
    margin: 1px 2px;
    padding: 2px 10px;
}

.convai-settings-badge {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    flex-shrink: 1;
}

.convai-settings-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    background-color: rgb(128, 128, 128);
}

.convai-settings-badge-dot--neutral {
    background-color: rgb(128, 128, 128);
}

.convai-settings-badge-dot--pending {
    background-color: rgb(84, 153, 199);
}

.convai-settings-badge-dot--ok {
    background-color: rgb(82, 183, 136);
}

.convai-settings-badge-dot--warn {
    background-color: rgb(214, 157, 56);
}

.convai-settings-badge-dot--error {
    background-color: rgb(214, 89, 89);
}

.convai-settings-badge-text {
    font-size: 10px;
    opacity: 0.85;
    white-space: normal;
}

.convai-settings-overrides-foldout {
    margin-top: 6px;
}

.convai-settings-override-row {
    margin-left: 8px;
}

.convai-settings-health-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    padding: 3px 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

.convai-settings-root--light .convai-settings-health-row {
    background-color: rgba(0, 0, 0, 0.03);
}

.convai-settings-health-badge {
    min-width: 220px;
    margin-left: 0;
}

.convai-settings-health-badge .convai-settings-badge-text {
    -unity-font-style: bold;
    font-size: 11px;
}

.convai-settings-health-message {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    opacity: 0.8;
    white-space: normal;
    margin: 0 6px;
}

/* Project Settings host: buttons and help boxes drawn like the IMGUI inspectors.
   Every value below comes from ConvaiEditorTokens (SDK/Editor/UI/ConvaiEditorTokens.cs); the
   skin-dependent ones are custom properties so each rule is written once for both skins.
   Hover rules require :enabled so a disabled control never shows the accent. */
.convai-settings-root--project-settings {
    --convai-text-primary: rgb(218, 224, 220);       /* TextPrimary (Pro) */
    --convai-text-muted: rgb(113, 122, 116);         /* TextMuted (Pro) */
    --convai-card-border: rgba(255, 255, 255, 0.055); /* CardBorder (Pro) */
    /* MessagePanelBg, and Tint(status) composited over it. ConvaiEditorFrame.MessageBox fills
       the two as separate layers; a USS background has one, so they are pre-blended. */
    --convai-message-bg: rgba(41, 43, 42, 0.92);
    --convai-message-info-bg: rgba(40, 54, 62, 0.93);
    --convai-message-warning-bg: rgba(62, 55, 42, 0.93);
    --convai-message-error-bg: rgba(60, 47, 46, 0.93);
}

.convai-settings-root--project-settings.convai-settings-root--light {
    --convai-text-primary: rgb(37, 42, 39);           /* TextPrimary (Light) */
    --convai-text-muted: rgb(116, 125, 119);          /* TextMuted (Light) */
    --convai-card-border: rgba(0, 0, 0, 0.13);        /* CardBorder (Light) */
    --convai-message-bg: rgba(219, 222, 220, 0.92);
    --convai-message-info-bg: rgba(193, 212, 223, 0.93);
    --convai-message-warning-bg: rgba(224, 215, 194, 0.93);
    --convai-message-error-bg: rgba(222, 203, 200, 0.93);
}

/* Ghost button (ConvaiEditorControls.GhostButton): accent outline over a faint accent wash.
   Accent rgb(82, 183, 136); AccentBright rgb(111, 207, 151); radius ControlRadius (5). */
.convai-settings-root--project-settings .unity-button {
    background-color: rgba(82, 183, 136, 0.10);       /* Fade(Accent, 0.10) */
    border-width: 1px;
    border-color: rgba(82, 183, 136, 0.6);            /* Fade(Accent, 0.6) */
    border-radius: 5px;
    color: var(--convai-text-primary);
}

/* Primary button (ConvaiEditorControls.PrimaryButton): the page's one main action, accent-filled.
   Declared before the :disabled rule below, which must win over it. */
.convai-settings-root--project-settings .unity-button.convai-settings-primary-button {
    background-color: rgb(82, 183, 136);              /* Accent */
    border-color: rgb(82, 183, 136);
    color: rgb(13, 24, 18);                           /* OnAccent */
    -unity-font-style: bold;
}

.convai-settings-root--project-settings .unity-button:hover:enabled {
    background-color: rgba(82, 183, 136, 0.22);       /* Fade(Accent, 0.22) */
    border-color: rgb(111, 207, 151);                 /* AccentBright */
    color: rgb(111, 207, 151);
}

.convai-settings-root--project-settings .unity-button:hover:active:enabled {
    color: rgb(82, 183, 136);                         /* Accent */
}

.convai-settings-root--project-settings .unity-button.convai-settings-primary-button:hover:enabled {
    background-color: rgb(111, 207, 151);             /* AccentBright */
    border-color: rgba(255, 255, 255, 0.22);          /* OnAccentHighlight */
    color: rgb(13, 24, 18);
}

.convai-settings-root--project-settings .unity-button.convai-settings-primary-button:hover:active:enabled {
    color: rgba(13, 24, 18, 0.7);                     /* Fade(OnAccent, 0.7) */
}

.convai-settings-root--project-settings .unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--convai-card-border);
    color: var(--convai-text-muted);
}

/* Message boxes (ConvaiEditorFrame.MessageBox): tinted panel, TintBorder(status) at 0.38,
   radius PanelRadius (6). The severity class is added by ConvaiSettingsUi.CreateHelpBox. */
.convai-settings-root--project-settings .convai-settings-helpbox {
    background-color: var(--convai-message-bg);
    border-width: 1px;
    border-color: var(--convai-card-border);
    border-radius: 6px;
}

.convai-settings-root--project-settings .convai-settings-helpbox--info {
    background-color: var(--convai-message-info-bg);
    border-color: rgba(33, 150, 243, 0.38);           /* StatusInfo */
}

.convai-settings-root--project-settings .convai-settings-helpbox--warning {
    background-color: var(--convai-message-warning-bg);
    border-color: rgba(255, 167, 38, 0.38);           /* StatusWarn */
}

.convai-settings-root--project-settings .convai-settings-helpbox--error {
    background-color: var(--convai-message-error-bg);
    border-color: rgba(239, 83, 80, 0.38);            /* StatusError */
}

/* Convai Editor host: reuse the Account page's white-card hierarchy and brand tokens.
   Project Settings keeps the compact, Unity-native treatment above. */
.convai-settings-root--configuration-window .convai-settings-section {
    margin: 0 0 10px 0;
    padding: 12px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(229, 231, 235);
    border-radius: 6px;
}

.convai-settings-root--configuration-window .convai-settings-section-header {
    min-height: 32px;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(209, 213, 219);
}

.convai-settings-root--configuration-window .convai-settings-section-title {
    font-size: 18px;
    letter-spacing: 0;
    color: rgb(9, 97, 72);
}

.convai-settings-root--configuration-window .convai-settings-section-actions {
    align-items: center;
    margin-left: 12px;
}

.convai-settings-root--configuration-window .convai-settings-card {
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.convai-settings-root--configuration-window .convai-settings-helpbox {
    margin: 0 0 10px 0;
    padding: 6px 8px;
    background-color: rgb(249, 250, 251);
    border-width: 1px;
    border-color: rgb(229, 231, 235);
    border-radius: 6px;
    color: rgb(75, 85, 99);
}

.convai-settings-root--configuration-window .convai-settings-field {
    min-height: 32px;
    margin: 2px 0 6px 0;
}

.convai-settings-root--configuration-window .convai-settings-field > .unity-base-field__label,
.convai-settings-root--configuration-window .convai-settings-field .unity-base-field__label {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    margin: 0 12px 0 0;
    padding: 0;
    flex-shrink: 0;
    color: rgb(45, 106, 79);
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.convai-settings-root--configuration-window .unity-base-popup-field__input,
.convai-settings-root--configuration-window .unity-popup-field__input,
.convai-settings-root--configuration-window .unity-enum-field__input {
    height: 32px;
    min-height: 32px;
    padding: 5px 10px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(209, 213, 219);
    border-radius: 6px;
    color: rgb(51, 51, 51);
}

/* The window stylesheet gives all text inputs generous Account-page padding.
   Settings uses a denser form grid, so normalize its text and slider inputs. */
.convai-settings-root--configuration-window .convai-settings-field #unity-text-input {
    height: 32px;
    min-height: 32px;
    margin: 0;
    padding: 5px 10px;
    border-width: 1px;
    border-color: rgb(209, 213, 219);
    border-radius: 6px;
    font-size: 14px;
}

.convai-settings-root--configuration-window .convai-settings-field .unity-base-slider__input {
    min-height: 32px;
    align-items: center;
}

.convai-settings-root--configuration-window .convai-settings-field .unity-base-slider__text-field {
    width: 64px;
    min-width: 64px;
    margin-left: 8px;
}

.convai-settings-root--configuration-window .convai-settings-primary-button {
    height: 32px;
    min-height: 32px;
    margin: 0;
    padding: 4px 12px;
    background-color: rgb(11, 96, 73);
    border-width: 1px;
    border-color: rgb(11, 96, 73);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.convai-settings-root--configuration-window .convai-settings-primary-button:hover {
    background-color: rgb(82, 183, 136);
    border-color: rgb(82, 183, 136);
    color: rgb(255, 255, 255);
}

.convai-settings-root--configuration-window .convai-settings-inline-button,
.convai-settings-root--configuration-window .convai-settings-reset-button,
.convai-settings-root--configuration-window .convai-settings-chip {
    height: 32px;
    min-height: 32px;
    margin: 0;
    padding: 3px 10px;
    background-color: rgb(249, 250, 251);
    border-width: 1px;
    border-color: rgb(209, 213, 219);
    border-radius: 6px;
    color: rgb(45, 106, 79);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.convai-settings-root--configuration-window .convai-settings-inline-button:hover,
.convai-settings-root--configuration-window .convai-settings-reset-button:hover,
.convai-settings-root--configuration-window .convai-settings-chip:hover {
    background-color: rgb(236, 253, 245);
    border-color: rgb(82, 183, 136);
    color: rgb(9, 97, 72);
}

.convai-settings-root--configuration-window .convai-settings-action-row,
.convai-settings-root--configuration-window .convai-settings-links-row,
.convai-settings-root--configuration-window .convai-settings-preset-row {
    align-items: center;
    flex-wrap: wrap;
    margin: 6px 0 8px 0;
}

.convai-settings-root--configuration-window .convai-settings-row {
    min-width: 0;
    align-items: center;
}

.convai-settings-root--configuration-window .convai-settings-apikey-row,
.convai-settings-root--configuration-window .convai-settings-mic-row {
    min-height: 32px;
    margin: 2px 0 6px 0;
}

.convai-settings-root--configuration-window .convai-settings-row > .convai-settings-field {
    min-width: 0;
    margin: 0;
}

.convai-settings-root--configuration-window .convai-settings-apikey-row > .convai-settings-apikey-field,
.convai-settings-root--configuration-window .convai-settings-mic-row > DropdownField {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.convai-settings-root--configuration-window .convai-settings-apikey-row > Button,
.convai-settings-root--configuration-window .convai-settings-mic-row > Button {
    margin-left: 8px;
}

.convai-settings-root--configuration-window .convai-settings-action-row {
    min-height: 32px;
    padding-left: 212px;
}

.convai-settings-root--configuration-window .convai-settings-action-row > Button,
.convai-settings-root--configuration-window .convai-settings-preset-row > Button,
.convai-settings-root--configuration-window .convai-settings-links-row > Button {
    margin: 2px 8px 2px 0;
}

.convai-settings-root--configuration-window .convai-settings-action-row > .convai-settings-badge {
    margin-left: 0;
}

.convai-settings-root--configuration-window .convai-settings-section-actions > Button,
.convai-settings-root--configuration-window .convai-settings-health-row > Button {
    margin: 0;
}

.convai-settings-root--configuration-window .convai-settings-preset-row > Label,
.convai-settings-root--configuration-window .convai-settings-subtitle {
    color: rgb(45, 106, 79);
    -unity-font-style: bold;
    font-size: 14px;
}

.convai-settings-root--configuration-window .convai-settings-preset-row > Label {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    margin: 2px 12px 2px 0;
    -unity-text-align: middle-left;
}

.convai-settings-root--configuration-window .convai-settings-hint,
.convai-settings-root--configuration-window .convai-settings-badge-text,
.convai-settings-root--configuration-window .convai-settings-health-message {
    color: rgb(107, 114, 128);
    opacity: 1;
    font-size: 12px;
}

.convai-settings-root--configuration-window .convai-settings-subgroup {
    margin-top: 8px;
    padding-left: 0;
}

.convai-settings-root--configuration-window .convai-settings-row > .convai-settings-hint {
    margin: 0 0 0 8px;
    padding: 0;
    -unity-text-align: middle-left;
}

.convai-settings-root--configuration-window .convai-settings-health-row {
    min-height: 34px;
    align-items: center;
    margin: 0;
    padding: 7px 4px;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 231, 235);
    border-radius: 0;
}

.convai-settings-root--configuration-window .convai-settings-health-badge {
    min-width: 250px;
}

.convai-settings-root--configuration-window .convai-settings-health-badge .convai-settings-badge-text {
    color: rgb(45, 106, 79);
    font-size: 13px;
}

.convai-settings-root--configuration-window .convai-settings-overrides-foldout {
    margin-top: 10px;
}

.convai-settings-root--configuration-window .convai-settings-override-row {
    margin-left: 0;
}
