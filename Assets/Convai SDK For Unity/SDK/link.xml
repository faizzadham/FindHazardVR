<!--
    IL2CPP Link Preservation for Convai SDK

    The SDK minimizes runtime reflection for type discovery; the remaining reflection-based
    factory (EmbodimentLipSyncBridge, which provisions the LipSync speech-energy adapter without
    a hard cross-module reference) needs its target type preserved below.
    Only types that require dynamic instantiation or serialization need preservation.

    Categories:
    - External dependencies (LiveKitBridge) - preserve all (we don't control their internals)
    - Networking transports - preserve for factory patterns and serialization
    - Modules with JSON/protobuf serialization - preserve data types
-->
<linker>
    <!-- External dependency - preserve all to avoid breaking changes -->
    <assembly fullname="LiveKitBridge" preserve="all"/>

    <!-- WebGL transport - preserves types for JS interop and message serialization -->
    <assembly fullname="Convai.Transport.WebGL">
        <!-- Controllers and factories -->
        <type fullname="Convai.Infrastructure.Networking.WebGL.*Controller" preserve="all"/>
        <type fullname="Convai.Infrastructure.Networking.WebGL.*Factory" preserve="all"/>
        <!-- Message types for JSON serialization -->
        <type fullname="Convai.Infrastructure.Networking.WebGL.Models.*" preserve="all"/>
    </assembly>

    <!-- Native transport - preserves types for LiveKit integration -->
    <assembly fullname="Convai.Transport.Native">
        <!-- Controllers and factories -->
        <type fullname="Convai.Infrastructure.Networking.Native.*Controller" preserve="all"/>
        <type fullname="Convai.Infrastructure.Networking.Native.*Factory" preserve="all"/>
    </assembly>

    <!-- Narrative module - preserves serializable data and managers -->
    <assembly fullname="Convai.Modules.Narrative">
        <!-- Scene data and configuration types -->
        <type fullname="Convai.Modules.Narrative.Data.*" preserve="all"/>
        <type fullname="Convai.Modules.Narrative.ConvaiNarrativeDesignManager" preserve="all"/>
    </assembly>

    <!-- Vision module - preserves types for camera and video processing -->
    <assembly fullname="Convai.Modules.Vision">
        <type fullname="Convai.Modules.Vision.ConvaiVisionPublisher" preserve="all"/>
        <type fullname="Convai.Modules.Vision.*Settings" preserve="all"/>
    </assembly>

    <!-- LipSync module - the speech-energy adapter is discovered and AddComponent'd purely by
         reflection (EmbodimentLipSyncBridge, from the engine-agnostic Runtime layer) when a
         LipSync component is present, so no serialized scene object or typed call site references
         it. Without this it would be stripped on IL2CPP (Android/iOS/WebGL) and embodiment
         gesticulation/breath would silently fall back to the statistical cadence on those
         platforms. -->
    <assembly fullname="Convai.Modules.LipSync">
        <type fullname="Convai.Modules.LipSync.ConvaiLipSyncSpeechEnergyAdapter" preserve="all"/>
    </assembly>

    <!-- Actions system - ConvaiActionExecutorBinder resolves a ConvaiActionSet's
         ExecutorTypeHint (a plain string authored in the Editor) to an IConvaiActionExecutor
         MonoBehaviour type purely by reflection over loaded assemblies (short/full type name,
         then case-insensitive). A project that references an action behavior only through a
         hint - never through a typed field or a `new` call - gives IL2CPP no compile-time
         reference to that type, so it is a stripping candidate: the hint would then resolve to
         nothing on device and the action would silently never run, with no editor warning
         possible until runtime. Preserve the namespaces the binder scans, not whole assemblies -
         do not remove these entries just because nothing else in the project appears to
         reference these types; that "nothing else references them" is exactly why they need to
         be listed here. -->
    <assembly fullname="Convai.Runtime">
        <type fullname="Convai.Runtime.Actions.*" preserve="all"/>
    </assembly>
    <assembly fullname="Convai.Modules.BodyAnimation">
        <type fullname="Convai.Modules.BodyAnimation.Executors.*" preserve="all"/>
    </assembly>
    <assembly fullname="Convai.Modules.BodyLanguage">
        <type fullname="Convai.Modules.BodyLanguage.Executors.*" preserve="all"/>
    </assembly>
    <assembly fullname="Convai.Modules.Emotion">
        <type fullname="Convai.Modules.Emotion.Executors.*" preserve="all"/>
    </assembly>
    <assembly fullname="Convai.Modules.Gaze">
        <type fullname="Convai.Modules.Gaze.Executors.*" preserve="all"/>
    </assembly>
</linker>
